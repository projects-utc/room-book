# Sao chép thành .env (đã bị .gitignore chặn) hoặc khai báo trong Render/Fly/Docker.
# KHÔNG commit giá trị thật.

ORACLE_DB_URL=jdbc:oracle:thin:@//<host>:<port>/<service>
ORACLE_DB_USER=<db_user>
ORACLE_DB_PASSWORD=<db_password>

# >= 32 ký tự. Sinh bằng: openssl rand -base64 48
APP_JWT_SECRET=<chuoi-ngau-nhien-dai>

# Origin của frontend, ngăn cách bằng dấu phẩy
APP_CORS_ORIGINS=https://<ten-mien-frontend>

# Chỉ bật khi cần tài khoản demo (admin, host.demo, guest.demo...)
APP_SEED_ENABLED=false
APP_SEED_PASSWORD=
